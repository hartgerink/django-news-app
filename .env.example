# Example settings for django-news-app.
#
# Copy this file to .env in the same folder, then replace each
# placeholder in angle brackets with your own value. The .env file is
# ignored by Git, so your secrets stay on your machine.
#
# Write each value as it is, with no quotes and no spaces around "=".

# --- Django ---

# A long, random, secret string that Django uses to sign sessions and
# password reset links.
DJANGO_SECRET_KEY=<your-secret-key>

# True while developing. Set to False on a live site.
DJANGO_DEBUG=True

# The host names the site may be served from, separated by commas.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (MariaDB) ---

# The database, and the user that Django connects as. The user also
# needs rights to test_news_db, which Django creates when the tests run.
DB_NAME=news_db
DB_USER=<your-database-user>
DB_PASSWORD=<your-database-password>

# Where the database server runs. Use localhost for a server on this
# machine.
DB_HOST=localhost
DB_PORT=3306

# --- Third-party sharing ---

# Approved articles are sent to this address. By default, it is the
# simulated third party in the third_party app, on the local server.
THIRD_PARTY_API_URL=http://127.0.0.1:8000/third-party/articles/

# The API key sent with each article. The simulated third party accepts
# whatever value is set here, so any string you choose will work.
THIRD_PARTY_API_KEY=<your-third-party-api-key>
