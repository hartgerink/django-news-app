# .gitignore for django-news-app
#
# Keeps secrets, virtual environments and generated files out of Git.
# The Sphinx HTML in docs/ is committed on purpose (see below).

# --- Secrets and local configuration ---
# Each developer creates their own .env from .env.example.
.env
.env.*
!.env.example
local_settings.py

# --- Virtual environments ---
venv/
.venv/
env/
ENV/

# --- Python bytecode ---
__pycache__/
*.py[cod]

# --- Django runtime files ---
*.log
*.sqlite3
media/
staticfiles/

# --- Sphinx documentation ---
# The built HTML stays in the repo so readers have the docs as soon as
# they clone it. Only the doctrees cache, which Sphinx rebuilds on every
# run, is left out.
docs/_build/doctrees/
docs/build/doctrees/

# --- Editors and operating systems ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
